{% if content %}
	{% if content.imagebg.layout_builder_add_block %}
		{{ content.imagebg }}
	{% endif %}
	{% if content.imagebg|layout_bg_img %}
		{% set attributes=attributes.merge(content.imagebg|layout_bg_img) %}
	{% endif %}
	<section {{attributes.addClass('textcotebg')}}>
		<div {% if settings.config_section %} class="{{ settings.config_section.type_container }} {{ settings.config_section.container_class }}" {% else %} class="container" {% endif %}>
			<div class="row">
				<div{{region_attributes.entete.addClass('entete')}}>
					{{content.entete}}
					{% if content.title|has_value %}
    					{% if settings.region_tag_title != '' %}
    						<{{settings.region_tag_title}} {{region_attributes.title.addClass('title')}}>
    							{{ content.title }}
    						</{{settings.region_tag_title}}>
    					{% else %}
    						<h2{{region_attributes.title.addClass('title')}}>
    							{{content.title}}
    						</h2>
    					{% endif %}
					{% endif %}
					{% if content.description %}
    					<div{{region_attributes.description.addClass('description')}}>
    						{{content.description}}
    					</div>
					{% endif %}
					{% if content.call_action %}
					<div{{region_attributes.call_action.addClass('call_action')}}>
						{{content.call_action}}
					</div>
					{% endif %}
					{%if content.lyt_footer %}
						<div{{region_attributes.lyt_footer.addClass('lyt_footer')}}>
							{{content.lyt_footer}}
						</div>
					{%endif %}
					{% if content.image %}
						<div{{region_attributes.image.addClass('image')}}>
							{{content.image}}
						</div>
					{%endif %}
				</div>
				{%if content.entete2 %}
					<div{{region_attributes.entete2.addClass('entete2')}}>
						{{content.entete2}}
						{% if content.title2 %}
    						{% if settings.region_tag_title2 != '' %}
    							<{{settings.region_tag_title2}} {{region_attributes.title2.addClass('title2')}}>
        							{{ content.title }}
        						</{{settings.region_tag_title2}}>
    						{% else %}
        						<h2{{region_attributes.title2.addClass('title2')}}>
        							{{content.title2}}
        						</h2>
    						{% endif %}
						{% endif %}
						{% if content.description2 %}
    						<div{{region_attributes.description2.addClass('description2')}}>
    							{{content.description2}}
    						</div>
						{% endif %}
						{% if content.call_action2 %}
    						<div{{region_attributes.call_action2.addClass('call_action2')}}>
    							{{content.call_action2}}
    						</div>
						{% endif %}
						{%if content.lyt_footer2 %}
							<div{{region_attributes.lyt_footer2.addClass('lyt_footer2')}}>
								{{content.lyt_footer2}}
							</div>
						{%endif %}
						{% if content.image2 %}
							<div{{region_attributes.image2.addClass('image2')}}>
								{{content.image2}}
							</div>
						{%endif %}
					</div>
					{%endif%}
				</div>
			</div>
		</section>
	{% endif  %}